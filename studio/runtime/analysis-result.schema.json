{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace.local/studio/runtime/analysis-result.schema.json",
  "title": "Speckit Analyze Machine Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "featureId",
    "outcome",
    "artifactHashes",
    "criticalFindings",
    "intentDriftCheck",
    "intentObligations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "featureId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "outcome": {
      "type": "string",
      "enum": [
        "IMPLEMENTATION_READY",
        "BLOCKED"
      ]
    },
    "artifactHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec.md",
        "readiness/readiness-assessment.md",
        "intent-ledger.md",
        "plan.md",
        "tasks.md"
      ],
      "properties": {
        "spec.md": {
          "$ref": "#/$defs/sha256"
        },
        "readiness/readiness-assessment.md": {
          "$ref": "#/$defs/sha256"
        },
        "intent-ledger.md": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "plan.md": {
          "$ref": "#/$defs/sha256"
        },
        "tasks.md": {
          "description": "SHA-256 of tasks.md after canonical T### checkbox states are normalized to [ ].",
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "criticalFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "summary",
          "resolution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "RESOLVED"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "resolution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "intentDriftCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "intentObligations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "items"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "NOT_REQUIRED",
            "ACCOUNTED",
            "BLOCKED"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceIntentItem",
              "classification",
              "status",
              "evidence"
            ],
            "properties": {
              "sourceIntentItem": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "classification": {
                "type": "string",
                "enum": [
                  "represented_by_substitute",
                  "deferred",
                  "dropped_with_owner_signoff"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "ACCOUNTED",
                  "BLOCKING"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
